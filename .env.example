# Copy to .env for local development:  cp .env.example .env
# Never commit .env — it is gitignored.

# ---- Postgres ----
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel

# ---- Application ----
# Hostnames below are Docker Compose service names.
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel
REDIS_URL=redis://redis:6379/0

# Redis list used as the probe work queue.
QUEUE_KEY=sentinel:checks

# How long a single HTTP probe may take before it is recorded as a failure.
PROBE_TIMEOUT_SECONDS=10

# How often the scheduler looks for monitors that are due.
SCHEDULER_INTERVAL_SECONDS=5

# How long a worker blocks waiting for queue items before looping.
WORKER_BLOCK_TIMEOUT_SECONDS=5

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
