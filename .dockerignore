# Keeping the build context small directly speeds up every docker build and
# avoids accidentally baking secrets or local state into an image.

.git/
.github/
.venv/
venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
.coverage
coverage.xml
htmlcov/

.env
.env.*
!.env.example

node_modules/
dist/

docs/
charts/
infra/
k8s/
*.md
!README.md

.terraform/
*.tfstate
*.tfstate.*

.DS_Store
.idea/
.vscode/
